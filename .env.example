# ─────────────────────────────────────────────
# Tripper — variáveis de ambiente
# Copie para .env (ou rode `npm run setup`) e preencha.
# Na Vercel: cadastre todas com `vercel env add <NOME>`.
# ─────────────────────────────────────────────

# Database (Neon - https://neon.tech) — use a connection string "pooled"
DATABASE_URL=

# Auth.js v5
AUTH_SECRET=              # gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_GOOGLE_ID=           # Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=          # Resend API Key (magic links)

# Stripe (https://dashboard.stripe.com) — use chaves de TESTE (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=    # stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_PRICE_ID_PRO=      # price_... do produto "Tripper PRO" (recorrente mensal)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (emails transacionais)
RESEND_API_KEY=
EMAIL_FROM="Tripper <onboarding@resend.dev>"   # troque por um domínio verificado no Resend
